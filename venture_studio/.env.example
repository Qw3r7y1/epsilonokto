# ── Venture Studio Configuration ──────────────────────────────────────────
# Copy to .env and fill in your values

# App
VS_ENVIRONMENT=dev
VS_DEBUG=true
VS_LOG_LEVEL=INFO

# Database
VS_DATABASE_URL=postgresql+asyncpg://venture:venture@localhost:5433/venture

# Redis / Celery
VS_REDIS_URL=redis://localhost:6380/0
VS_CELERY_BROKER_URL=redis://localhost:6380/1
VS_CELERY_RESULT_BACKEND=redis://localhost:6380/2

# Claude API
VS_ANTHROPIC_API_KEY=
VS_CLAUDE_MODEL=claude-sonnet-4-20250514

# SerpAPI
VS_SERPAPI_KEY=

# Stripe
VS_STRIPE_SECRET_KEY=
VS_STRIPE_WEBHOOK_SECRET=

# Cloudflare R2
VS_R2_ACCOUNT_ID=
VS_R2_ACCESS_KEY=
VS_R2_SECRET_KEY=
VS_R2_BUCKET=venture-assets

# Governance
VS_GLOBAL_KILL_SWITCH=false
VS_MAX_DAILY_SPEND_USD=50.0
VS_MAX_EXPERIMENT_SPEND_USD=20.0
VS_MAX_CONCURRENT_EXPERIMENTS=5
VS_CIRCUIT_BREAKER_THRESHOLD=5

# Pod
VS_ACTIVE_POD=affiliate

# Observability
VS_PLAUSIBLE_DOMAIN=
VS_METABASE_URL=
