# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="Maillard Back Office"
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
# Overridden to db:5432 inside docker compose
DATABASE_URL=postgresql://maillard:maillard@localhost:5432/maillard

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local          # "local" or "s3"
LOCAL_UPLOAD_DIR=data/raw_uploads
LOCAL_PROCESSED_DIR=data/processed_text
LOCAL_EXPORT_DIR=data/exports

# S3 (only needed when STORAGE_BACKEND=s3)
AWS_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── OCR ───────────────────────────────────────────────────────────────────────
TESSERACT_CMD=tesseract
OCR_DPI=300
OCR_LANG=eng

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
