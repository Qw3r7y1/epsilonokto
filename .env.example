# ── Database ──────────────────────────────────────────────
POSTGRES_USER=maillard
POSTGRES_PASSWORD=changeme
POSTGRES_DB=maillard_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── App ──────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-random-string
API_PREFIX=/api/v1

# ── File Storage ─────────────────────────────────────────
UPLOAD_DIR=./data/raw_uploads
PROCESSED_DIR=./data/processed_text
MAX_UPLOAD_SIZE_MB=20

# ── OCR ──────────────────────────────────────────────────
TESSERACT_CMD=/usr/bin/tesseract
OCR_LANGUAGE=eng

# ── S3 (production) ─────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=maillard-invoices
# AWS_REGION=us-east-1

